# Copier en .env puis remplir. Toutes les clés sont optionnelles.

# Base de données (chemin dans le conteneur)
DATABASE_URL=sqlite:////data/myludo.db

# Mot de passe d'accès, à définir avant toute exposition sur Internet
APP_PASSWORD=

# BoardGameGeek : jeton obtenu après inscription de l'application sur boardgamegeek.com
BGG_TOKEN=

# YouTube Data API v3 : clé gratuite depuis la console Google Cloud
YOUTUBE_API_KEY=
# Chaînes de règles en français, par ordre de priorité, séparées par des virgules
YOUTUBE_CHANNELS=Ludochrono

# API Claude : brouillons de règles simplifiées et fiches débutants (payant)
ANTHROPIC_API_KEY=

# Modules de relevé de prix activés, séparés par des virgules (ex. philibert,okkazeo)
PRICE_SOURCES=
# Fréquence du relevé automatique, format cron
PRICE_REFRESH_CRON=0 3 * * *
